{
  "name": "dineflow-desktop",
  "version": "1.0.0",
  "description": "Dineflow Restaurant Kitchen & POS Desktop Application",
  "main": "src/main.js",
  "author": "Dineflow Team",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:all": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dineflow.desktop",
    "productName": "Dineflow",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "config.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "sign": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dineflow"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Zavyar-Riasat",
        "repo": "QR-restraunt-dashboard"
      }
    ]
  }
}
