# ============================================================================
# Coolify PostgreSQL Database Configuration
# ============================================================================
# Create a PostgreSQL resource in Coolify and paste the connection string below:
DATABASE_URL=postgresql://postgres:your_password@your-coolify-postgres-host:5432/dineflow
DATABASE_SSL=false

# Set to true when DATABASE_URL is connected to enable live PostgreSQL sync from the frontend:
VITE_USE_POSTGRES_API=false
VITE_APP_URL=https://yourdomain.com

# 32-byte (64 random hex characters) key for AES-256-GCM password encryption & decryption. Keep backed up securely!
PASSWORD_ENCRYPTION_KEY=4da2976b1f2bb1cb99777f84f26b22cda25739ae694ab9da6293729f29918e34
VITE_PASSWORD_ENCRYPTION_KEY=4da2976b1f2bb1cb99777f84f26b22cda25739ae694ab9da6293729f29918e34

# ============================================================================
# Gmail OTP Email Delivery (Required for sending 6-digit OTP to Gmail inbox)
# ============================================================================
# 1. Enter your sender Gmail address below:
GMAIL_USER=your_email@gmail.com
# 2. Generate a 16-character Google App Password from:
#    Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional Alternative: Use Resend API instead of Gmail SMTP
RESEND_API_KEY=
RESEND_FROM_EMAIL=Dineflow <onboarding@resend.dev>

# ============================================================================
# Google OAuth 2.0 Popup Sign-In (Optional for 1-Click "Continue with Google")
# ============================================================================
VITE_GOOGLE_CLIENT_ID=
